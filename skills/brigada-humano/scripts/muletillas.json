    {"id": "preambulo", "regex": "(?i)\\b(?:en (?:este|el) (?:v[ií]deo|reel|post|carrusel)(?: de hoy)? (?:te|os) (?:voy|vamos) a|hoy (?:te|os) traigo)\\b", "nombre": "Preámbulo de vídeo", "arreglo": "Bórralo y empieza por lo que importa."},
